# Supabase — https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# QRtım entegrasyonu (opsiyonel)
VITE_QRTIM_URL=https://qartim.com

# ─────────────────────────────────────────────────────────────────────────────
# TURN relay
#
# ÜRETİMDE BUNLARI KULLANMAYIN. TURN kimlik bilgisi artık `turn-credentials`
# edge fonksiyonu tarafından süreli olarak üretilir; sır sunucuda kalır.
# Kurulum: TURN_SETUP.md
#
# Aşağıdaki değişkenler yalnızca YEREL GELİŞTİRME içindir. Tanımlanırsa,
# edge fonksiyonu TURN veremediğinde yedek olarak kullanılırlar. Build'e
# gömüldükleri için üretimde kullanılmaları statik parolayı ifşa eder.
# ─────────────────────────────────────────────────────────────────────────────
# VITE_TURN_URL=turn:localhost:3478
# VITE_TURN_USERNAME=test
# VITE_TURN_CREDENTIAL=test
